# Copy to ai/.env and fill in. ai/.env is git-ignored; never commit a real key.

# ISDLC backend (run it locally first, see the root README)
ISDLC_API_URL=http://localhost:5091

# Gemini API key: https://aistudio.google.com/apikey
# Use a key from a paid project or company account. Free-tier data may be used by the provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# HTTP service (uvicorn isdlc_ai.server:app). Same value as the backend's Agents:ServiceKey.
# The development value below matches appsettings.Development.json; use a real secret anywhere else.
AGENT_SERVICE_KEY=isdlc-dev-agent-key
