      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Isdlc.Application\Isdlc.Application.csproj" />
    <ProjectReference Include="..\Isdlc.Infrastructure\Isdlc.Infrastructure.csproj" />
  </ItemGroup>

</Project>
