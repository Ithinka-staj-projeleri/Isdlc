<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Isdlc.Application\Isdlc.Application.csproj" />
    <ProjectReference Include="..\Isdlc.Domain\Isdlc.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!-- Security pin: SqlClient pulls a vulnerable version (CVE-2026-84008, CVE-2026-70162, fixed in 10.0.13).
         Remove once EF Core SqlServer brings a patched version by itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed JSON files are embedded so they travel with the DLL. -->
    <EmbeddedResource Include="Seed\*.json" />
    <EmbeddedResource Include="Seed\flows\*.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
